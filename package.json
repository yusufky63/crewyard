{
  "name": "crewyard",
  "version": "0.2.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "pnpm --filter @crewyard/desktop dev",
    "build": "pnpm --filter @crewyard/desktop build && pnpm --filter @crewyard/web build",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint . --max-warnings=0",
    "test": "vitest run",
    "e2e": "pnpm --filter @crewyard/desktop e2e",
    "tokens": "node scripts/build-tokens.mjs",
    "contrast": "node design/check-contrast.mjs",
    "catalog:sync": "node catalog/sync-catalog.mjs",
    "logos:sync": "node catalog/sync-logos.mjs",
    "package": "pnpm --filter @crewyard/desktop package",
    "stress": "pnpm --filter @crewyard/daemon stress",
    "conformance": "pnpm --filter @crewyard/daemon conformance",
    "scan:history": "node scripts/scan-history.mjs",
    "check": "pnpm tokens --check && pnpm contrast && pnpm typecheck && pnpm lint && pnpm test && pnpm build"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.19.2",
    "eslint": "10.13.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vitest": "5.0.5"
  }
}
